{
  "name": "iham",
  "version": "1.0.7",
  "description": "interactive HOG Analysis Method visualisation plugin",
  "main": "index.js",
  "browser": "build/iHam.js",
  "style": "build/iHam.css",
  "files": [
    "index.js",
    "browser.js",
    "index.scss",
    "src",
    "build"
  ],
  "directories": {
    "example": "examples"
  },
  "dependencies": {
    "d3": "~3.5.17",
    "iham-parsers": "^0.2.1",
    "jquery": "^3.7.1",
    "tnt.api": "^0.1.1",
    "tnt.tooltip": "^0.2.0",
    "tntvis": "^0.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "sass": "^1.80.0"
  },
  "scripts": {
    "build": "npm run build-js && npm run build-css",
    "build-js": "node build.mjs",
    "build-css": "sass --no-source-map --silence-deprecation=import --quiet-deps --load-path=. index.scss build/iHam.css",
    "watch": "node build.mjs --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "viewer",
    "interaction",
    "openTargets"
  ],
  "author": "Miguel Pignatelli <emepyc@gmail.com>",
  "license": "Apache-2.0"
}
