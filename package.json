{
  "name": "iham",
  "version": "2.0.0-alpha.7",
  "description": "iHam: interactive viewer for hierarchical orthologous groups (HOGs) as a Vue 3 component and <i-ham> web component",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Adrian Altenhoff <adrian.altenhoff@inf.ethz.ch>",
  "contributors": [
    "Miguel Pignatelli <emepyc@gmail.com> (original author, iHam 1)",
    "Clément-Marie Train"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DessimozLab/iHam.git"
  },
  "keywords": [
    "orthology",
    "HOG",
    "phylogeny",
    "vue",
    "web-component"
  ],
  "files": [
    "dist",
    "!dist/element/*.map",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "main": "./dist/iham.js",
  "module": "./dist/iham.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/iham.js"
    },
    "./style.css": "./dist/iham.css",
    "./element": {
      "types": "./dist/types/element.d.ts",
      "import": "./dist/element/iham-element.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/element/iham-element.iife.js",
  "jsdelivr": "./dist/element/iham-element.iife.js",
  "sideEffects": [
    "./dist/element/*",
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:element && npm run build:types",
    "build:lib": "vite build --mode lib",
    "build:element": "vite build --mode element",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "build:demo": "npm run build:element && vite build",
    "prepack": "npm run build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:demo && playwright test"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "d3-scale": "^4.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "iham-parsers": "^0.2.1",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
